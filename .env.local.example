# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Required for admin panel mutations (bypasses RLS — server-only, never public)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Password to access /admin  (choose something strong)
ADMIN_PASSWORD=change-me-please

# ─── Vercel cron job ──────────────────────────────────────────────────────────
# Random secret sent as  Authorization: Bearer <token>
# Generate with:  openssl rand -hex 32
# Add to Vercel Dashboard → Settings → Environment Variables too
CRON_SECRET=generate-a-random-secret-here
